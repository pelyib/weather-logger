version: 0.0.1

logger:
  cities:
    - name: "{city name}"
      longitude: "{longitude}"
      latitude: "{latitude}"
  forecast-providers:
    openWeather:
      appid: "{your app id / key}"
    accuweather:
      appid: "{your app id}"
    openMeteo:
      timezone: "Europe/Berlin"
      models:
        - "ecmwf_ifs"
        - "jma_seamless"
        - "gfs_seamless"
        - "gem_regional"
        - "icon_eu"
        - "meteofrance_arpege_europe"
        - "ukmo_seamless"
        - "meteoswiss_icon_seamless"
        - "kma_seamless"
        - "metno_seamless"
        - "geosphere_seamless"
  database:
    folder: "/path/to/database/"
    fileName: "filename.db"
    buckets:
      - "accuweather.raw_response"
      - "openweather.raw_response"
      - "openmeteo.raw_response"
  mq:
    user: "mq-user"
    password: "mq-password"
    domain: "mq.domain"
    port: 1234
    vhost: "mq-vhost"
http:
  port: 80
  template:
    index: "/path/to/index/template.html"
  mq:
    user: "mq-user"
    password: "mq-password"
    domain: "mq.domain"
    port: 1234
    vhost: "mq-vhost"
  database:
    folder: "/path/to/database/"
    fileName: "filename.db"
    buckets: 
      - "http-bucket-a"
      - "http-bucket-b"
